{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "vite-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "vite-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:phone"
      ],
      "port": 5174,
      "url": "https://localhost:5174"
    }
  ]
}
