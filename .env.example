# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Gemini runs through Firebase AI Logic: no API key in the app (see utils/gemini.ts).
# Optional: reCAPTCHA v3 site key for Firebase App Check, which stops other sites
# using the project's AI quota. Register the site in Firebase console → App Check.
VITE_RECAPTCHA_SITE_KEY=

# Web Push key for push notifications: Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → "Generate key pair" (public key).
# Leave empty to hide the Push notifications switch.
VITE_FCM_VAPID_KEY=
